# ARIA Cloud on a small Iranian or European VPS.
# The VPS only runs the API gateway; AI inference happens at the API providers.
ARIA_DOMAIN=api.example.com
ARIA_OWNER_NAME=Milad
ARIA_PORT=8000
ARIA_DB=/data/aria_cloud.db

# Iran-friendly OpenAI-compatible text + image gateway (Doona).
# Create an API key in the Doona dashboard and keep it on the server only.
ARIA_PROVIDER=doona
ARIA_API_BASE_URL=https://platform.doona.ai/v1/chat/completions
ARIA_API_KEY=
ARIA_MODEL=gemini-3.5-flash-lite

# Doona image generation. It may use paid credits.
ARIA_IMAGE_API_URL=https://platform.doona.ai/v1/images/generations
# Leave blank to reuse ARIA_API_KEY, or set a separate image key.
ARIA_IMAGE_API_KEY=
ARIA_IMAGE_MODEL=gpt-image-2

# Beta guardrails
ARIA_MEDIA_ENABLED=false
ARIA_TRIAL_DAYS=30
ARIA_MONTHLY_PRICE_TOMAN=99000

# Video is provided separately by Pollinations. Use a server-only sk_ key.
# Never put this key in the Android app or APK.
POLLINATIONS_API_KEY=
ARIA_VIDEO_MODEL=bytedance/seedance-2.0-mini

# Optional alternatives for text:
# 1xAi base: https://1xai.ir/v1/chat/completions
# 1xAi model: choose an active model ID from its dashboard/catalog.
# OpenRouter base: https://openrouter.ai/api/v1/chat/completions
# OpenRouter model: openrouter/free
#
# Public app/release settings
ARIA_OWNER_EMAIL=miladdeljoui22@gmail.com
ARIA_PUBLIC_BASE_URL=https://aria-2.weblines.ir
ARIA_GOOGLE_CLIENT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
ARIA_GITHUB_RELEASES_URL=https://api.github.com/repos/Miladdeljoui/ARIA/releases/latest
