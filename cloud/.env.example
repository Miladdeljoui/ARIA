# ARIA Cloud: all model calls run through an OpenAI-compatible gateway.
# For Iranian VPS / networks use NetArz's domestic Gisoo endpoint.
# Keep every API key only in the VPS secret manager or private .env file.
ARIA_HOST=0.0.0.0
ARIA_PORT=8000
ARIA_DB=/data/aria_cloud.db
ARIA_OWNER_NAME=Milad
ARIA_OWNER_EMAIL=miladdeljoui22@gmail.com
ARIA_DOMAIN=api.your-domain.ir

# Chat + live model catalog (GPT, Gemini, DeepSeek, Claude/OpenRouter, Qwen, etc.)
ARIA_PROVIDER=netarz
ARIA_API_BASE_URL=https://ir.gisoo.pro/api/v1/chat/completions
ARIA_API_KEY=
ARIA_MODEL=deepseek-flash
ARIA_MAX_OUTPUT_TOKENS=1200
# Leave empty to use the live chat catalogue from /models?type=chat.
# For a small curated launch, use comma-separated IDs, e.g.:
# deepseek-flash,gpt-4o-mini,openrouter/anthropic/claude-sonnet-4.5
ARIA_ALLOWED_MODELS=

# Image generation shares the NetArz key by default; separate key is optional.
ARIA_IMAGE_API_URL=https://ir.gisoo.pro/api/v1/images/generations
ARIA_IMAGE_API_KEY=
ARIA_IMAGE_MODEL=gemini-3.1-flash-lite-image
ARIA_IMAGE_QUALITY=low

# Video generation shares the NetArz key by default; keep disabled until a spending cap is set.
ARIA_VIDEO_API_URL=https://ir.gisoo.pro/api/v1/videos
ARIA_VIDEO_API_KEY=
ARIA_VIDEO_MODEL=veo-3.1-fast
ARIA_VIDEO_TIMEOUT_SECONDS=300
ARIA_VIDEO_POLL_SECONDS=5

# Important: first test chat only. After setting project-key limits, enable media deliberately.
ARIA_MEDIA_ENABLED=false

# New installs have a 30-day trial; subscription code is present but requires a live Zarinpal merchant.
ARIA_TRIAL_DAYS=30
ARIA_MONTHLY_PRICE_TOMAN=99000
ARIA_PUBLIC_BASE_URL=https://api.your-domain.ir
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=

# Optional domestic provider alternatives (use only after testing the account):
# AvalAI: ARIA_PROVIDER=avalai, ARIA_API_BASE_URL=https://api.avalai.ir/v1/chat/completions
# Doona:  ARIA_PROVIDER=doona,  ARIA_API_BASE_URL=https://platform.doona.ai/v1/chat/completions
# OpenRouter is not selected by default; check its regional terms and availability before use.

# GitHub Releases feed
ARIA_GITHUB_RELEASES_URL=https://api.github.com/repos/Miladdeljoui/ARIA/releases/latest
