# ARIA gateway: no GPU required. Model inference is hosted by AI providers.
# Keep both keys on the VPS only. Never commit a real .env file to GitHub.
ARIA_HOST=0.0.0.0
ARIA_PORT=8000
ARIA_DB=/data/aria_cloud.db
ARIA_OWNER_NAME=Milad
ARIA_OWNER_EMAIL=miladdeljoui22@gmail.com
ARIA_DOMAIN=api.your-domain.ir

# Main text + image gateway: 1xAi (one API key, models from multiple vendors)
# Finish account identity verification and create the key in the 1xAi dashboard.
ARIA_PROVIDER=1xai
ARIA_API_BASE_URL=https://1xai.ir/v1/chat/completions
ARIA_API_KEY=
ARIA_MODEL=deepseek-chat
# Leave empty to use the complete live /v1/models catalogue. To restrict models, enter comma-separated model IDs.
ARIA_ALLOWED_MODELS=

# 1xAi image API. Image generations are billable from the API wallet.
ARIA_IMAGE_API_URL=https://1xai.ir/v1/images/generations
ARIA_IMAGE_API_KEY=
ARIA_IMAGE_MODEL=gpt-image-2

# Separate AvalAI key for short video generation. This is not included in 1xAi.
# AvalAI documents POST /v1/videos, status polling and content download.
ARIA_VIDEO_API_URL=https://api.avalai.ir/v1/videos
ARIA_VIDEO_API_KEY=
ARIA_VIDEO_MODEL=veo-3.1-fast-generate-001
ARIA_VIDEO_TIMEOUT_SECONDS=300
ARIA_VIDEO_POLL_SECONDS=5

# Keep media disabled until keys, quotas and provider wallet limits are tested.
ARIA_MEDIA_ENABLED=false

# Trial and payments: keep sandbox until a valid merchant ID and public HTTPS domain exist.
ARIA_TRIAL_DAYS=30
ARIA_MONTHLY_PRICE_TOMAN=99000
ARIA_PUBLIC_BASE_URL=https://YOUR-REAL-API-DOMAIN
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=

# GitHub Releases feed
ARIA_GITHUB_RELEASES_URL=https://api.github.com/repos/Miladdeljoui/ARIA/releases/latest
