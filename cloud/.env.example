# ARIA Cloud: use a small VPS only as the secure API gateway.
# No GPU is needed here. The AI provider hosts inference.
ARIA_DOMAIN=api.example.com
ARIA_OWNER_NAME=Milad
ARIA_PORT=8000
ARIA_DB=/data/aria_cloud.db

# Recommended Iran-friendly starter: AvalAI unified API.
# A signup API credit is advertised in AvalAI's current dashboard; verify exact amount and eligibility.
# Confirm your current balance and model prices in your AvalAI dashboard.
ARIA_PROVIDER=avalai
ARIA_API_BASE_URL=https://api.avalai.ir/v1/chat/completions
ARIA_API_KEY=
ARIA_MODEL=deepseek-flash

# Image generation through the same AvalAI account/key.
ARIA_IMAGE_API_URL=https://api.avalai.ir/v1/images/generations
ARIA_IMAGE_API_KEY=
ARIA_IMAGE_MODEL=muse-image-1.0

# Video generation through AvalAI's async Videos API (server-side secret only).
# Veo fast is metered per second; verify current price and set a spending cap before enabling.
ARIA_VIDEO_API_URL=https://api.avalai.ir/v1/videos
ARIA_VIDEO_API_KEY=
ARIA_VIDEO_MODEL=veo-3.1-fast-generate-001

# Keep media disabled until provider-side budgets and usage limits are configured.
ARIA_MEDIA_ENABLED=false

# Alternative gateways: use a compatible endpoint and exact model ID from its catalogue.
# Doona:
# ARIA_PROVIDER=doona
# ARIA_API_BASE_URL=https://platform.doona.ai/v1/chat/completions
# ARIA_MODEL=gemini-3.5-flash-lite
# ARIA_IMAGE_API_URL=https://platform.doona.ai/v1/images/generations
# ARIA_IMAGE_MODEL=gpt-image-2
#
# 1xAi:
# ARIA_PROVIDER=1xai
# ARIA_API_BASE_URL=https://1xai.ir/v1/chat/completions
# ARIA_MODEL=deepseek-chat
#
# HeroAI with the documented Iran mirror (one virtual key for its model gateway):
# ARIA_PROVIDER=heroai
# ARIA_API_BASE_URL=https://iranapi.heroai.ir/ai/chat/completions
# ARIA_MODEL=deepseek/deepseek-chat
# Image/video endpoints are exposed by HeroAI too, but their payload/status flow
# must be adapted and verified before switching ARIA's current media adapters.
#
# OpenRouter:
# ARIA_PROVIDER=openrouter
# ARIA_API_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# ARIA_MODEL=openrouter/free

# ARIA beta settings
ARIA_OWNER_EMAIL=miladdeljoui22@gmail.com
ARIA_TRIAL_DAYS=30
ARIA_MONTHLY_PRICE_TOMAN=99000
ARIA_PUBLIC_BASE_URL=https://aria-2.weblines.ir
ARIA_GOOGLE_CLIENT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=

# Release update metadata
ARIA_GITHUB_RELEASES_URL=https://api.github.com/repos/Miladdeljoui/ARIA/releases/latest

# For Weblines, mount a persistent volume at /data and keep ARIA_DB above.
ARIA_HOST=0.0.0.0
