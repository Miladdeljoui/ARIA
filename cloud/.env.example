# Set this to a domain/subdomain whose DNS A record points to your VPS; Caddy will issue HTTPS.
ARIA_DOMAIN=api.example.com
ARIA_OWNER_NAME=Milad
# If a hosted OpenRouter key is set, ARIA automatically selects openrouter/free unless ARIA_MODEL is explicitly changed.
ARIA_MODEL=openrouter/free
ARIA_PORT=8000
ARIA_DB=/data/aria_cloud.db

# ARIA beta settings
ARIA_OWNER_EMAIL=miladdeljoui22@gmail.com
ARIA_TRIAL_DAYS=30
ARIA_MONTHLY_PRICE_TOMAN=99000
ARIA_PUBLIC_BASE_URL=https://aria-2.weblines.ir
ARIA_GOOGLE_CLIENT_ID=

# Start with Zarinpal sandbox. Keep credentials in hosting secrets, never in APK/Git.
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
# The key is a server secret. Never put it in the Android app or commit a real value.
ARIA_API_BASE_URL=https://openrouter.ai/api/v1/chat/completions
ARIA_API_KEY=
# Accept OPENROUTER_API_KEY as an alternative environment variable.
# Free text chat uses OpenRouter's dynamic free-model router when a key is configured.
# Media generation can consume paid credits. Keep disabled until you have set a hard spending limit.
ARIA_MEDIA_ENABLED=false
ARIA_IMAGE_MODEL=bytedance-seed/seedream-4.5
ARIA_VIDEO_MODEL=bytedance/seedance-2.0

# Public GitHub release metadata endpoint used by ARIA's update-check API
ARIA_GITHUB_RELEASES_URL=https://api.github.com/repos/Miladdeljoui/ARIA/releases/latest
